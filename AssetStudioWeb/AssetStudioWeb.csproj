<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Version>0.16.0.0</Version>
    <!-- No native relinking / workloads needed: the texture decoder is a separate wasm module (wwwroot/decoder). -->
    <WasmEnableWebcil>true</WasmEnableWebcil>
    <EnableDefaultCompressedItems>false</EnableDefaultCompressedItems>
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AssetStudio\AssetStudio.csproj" />
    <ProjectReference Include="..\AssetStudioUtility\AssetStudioUtility.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ImageSharp is not trim-annotated; keep it whole so sprite cutting works after publish trimming. -->
    <TrimmerRootAssembly Include="SixLabors.ImageSharp" />
    <TrimmerRootAssembly Include="SixLabors.ImageSharp.Drawing" />
  </ItemGroup>

</Project>
